{
  "name": "allergen-planner",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "tsx src/engine/engine.test.ts",
    "db:local": "wrangler d1 execute allergen-planner --local --file=./schema.sql",
    "db:remote": "wrangler d1 execute allergen-planner --remote --file=./schema.sql",
    "deploy": "npm run build && wrangler pages deploy dist --project-name=allergen-planner --branch=main"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241106.0",
    "@types/node": "^22.20.3",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vite-plugin-pwa": "^0.20.5",
    "wrangler": "^3.86.0"
  }
}
